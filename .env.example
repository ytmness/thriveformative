# Supabase (https://supabase.com/dashboard/project/TU_PROJECT_REF)
# La URL es: https://TU_PROJECT_REF.supabase.co
# Sin estas variables (o con nombres sin NEXT_PUBLIC_) verás "No API key found in request".
NEXT_PUBLIC_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aqui

# Solo servidor; NUNCA expongas esta clave en el cliente
# SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui

# Resend — usado por la Edge Function de Supabase (send-appointment-email), no por Next.js
# Configurar en Supabase: supabase secrets set RESEND_API_KEY=re_xxx RESEND_FROM="..."

# Correo desde la app (nodemailer → Postfix en el servidor)
# Por defecto usa localhost:25. Si el servidor usa relay externo, opcional:
# SMTP_HOST=localhost
# SMTP_PORT=25
# SMTP_USER= SMTP_PASS= (solo si el relay exige auth)

# URL pública del sitio (para imágenes en plantillas de correo HTML)
NEXT_PUBLIC_SITE_URL=https://thriveformative.com

# Email donde recibir avisos de nuevas solicitudes de contacto (formulario)
NOTIFY_EMAIL=info@thriveformative.com

# Contraseña para desbloquear la web cuando está en modo "Coming Soon"
# Si no está definida, la pantalla de coming soon mostrará "Acceso no configurado"
COMING_SOON_PASSWORD=tu_contraseña_secreta
