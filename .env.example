# Thrive Formative — entorno local / servidor
# Copia a .env.local (dev) o .env (PM2 en el VPS).

# ─── Postgres local (estilo Somnus) ─────────────────────────────────────────
# Docker: somnus-pg en 127.0.0.1:5432 — ver scripts/setup-thrive-db.sh
DATABASE_URL=postgresql://thrive_app:CHANGE_ME@127.0.0.1:5432/thriveformative

# Admin del CMS/tienda (cookie firmada; no es cuenta de paciente)
ADMIN_PASSWORD=cambia_esta_contraseña
ADMIN_SESSION_SECRET=genera_un_secreto_largo_aleatorio

# ─── Sitio / correo ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://thriveformative.com
NOTIFY_EMAIL=info@thriveformative.com

# Contraseña para desbloquear la web cuando está en modo "Coming Soon"
# COMING_SOON_PASSWORD=

# SMTP (nodemailer → Postfix en el servidor; opcionales)
# SMTP_HOST=localhost
# SMTP_PORT=25

# ─── Pabau (agenda de récord — pacientes) ───────────────────────────────────
# Portal / Client Portal (NO uses app-us.pabau.com — eso es staff)
NEXT_PUBLIC_PABAU_COMPANY_SLUG=thrive-formative-llc
NEXT_PUBLIC_PABAU_BOOKING_URL=https://partner-us.pabau.com/online-bookings/thrive-formative-llc
NEXT_PUBLIC_PABAU_BOOKING_SHAPESCALE_URL=https://partner-us.pabau.com/online-bookings/thrive-formative-llc?category=314027&services=3571762

# Solo servidor — NUNCA NEXT_PUBLIC_*. Rotar en Pabau Developer Hub.
# PABAU_ACCESS_TOKEN=
# PABAU_API_BASE=https://api.oauth.pabau.com

# ─── Supabase (DEPRECADO en Thrive) ─────────────────────────────────────────
# Ya no se usa para auth de pacientes ni CMS. Puedes omitir estas variables.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
